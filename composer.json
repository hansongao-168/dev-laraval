{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "filament/filament": "^5.0",
        "gz168/api-auth": "@dev",
        "gz168/cache-management": "@dev",
        "gz168/common": "@dev",
        "gz168/custom-config": "@dev",
        "gz168/database-backup": "@dev",
        "gz168/deepseek": "@dev",
        "gz168/export-management": "@dev",
        "gz168/extension-data": "@dev",
        "gz168/filament": "@dev",
        "gz168/filament-admin": "@dev",
        "gz168/git-management": "@dev",
        "gz168/log-management-page": "@dev",
        "gz168/module-core": "@dev",
        "gz168/module-settings": "@dev",
        "gz168/package-registration": "@dev",
        "gz168/role-permission": "@dev",
        "gz168/system-settings": "@dev",
        "gz168/user-management": "@dev",
        "laravel/framework": "^13.8",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "php": "^8.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.4",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan app:initialize --force",
            "npm install --ignore-scripts",
            "npm run setup:clients",
            "npm run build:all"
        ],
        "initialize": [
            "@php artisan app:initialize --force"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "gz168/ApiAuth"
        },
        {
            "type": "path",
            "url": "gz168/CacheManagement"
        },
        {
            "type": "path",
            "url": "gz168/CustomConfig"
        },
        {
            "type": "path",
            "url": "gz168/DatabaseBackup"
        },
        {
            "type": "path",
            "url": "gz168/ExportManagement"
        },
        {
            "type": "path",
            "url": "gz168/ExtensionData"
        },
        {
            "type": "path",
            "url": "gz168/Filament"
        },
        {
            "type": "path",
            "url": "gz168/GitManagement"
        },
        {
            "type": "path",
            "url": "gz168/LogManagementPage"
        },
        {
            "type": "path",
            "url": "gz168/ModuleSettings"
        },
        {
            "type": "path",
            "url": "gz168/PackageRegistration"
        },
        {
            "type": "path",
            "url": "gz168/RolePermission"
        },
        {
            "type": "path",
            "url": "gz168/SystemSettings"
        },
        {
            "type": "path",
            "url": "gz168/UserManagement"
        },
        {
            "type": "path",
            "url": "gz168/common"
        },
        {
            "type": "path",
            "url": "gz168/deepseek"
        },
        {
            "type": "path",
            "url": "gz168/filament-admin"
        },
        {
            "type": "path",
            "url": "gz168/module-core"
        }
    ]
}
