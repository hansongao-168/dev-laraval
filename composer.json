{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "gz168/api-auth": "dev-master",
        "gz168/attribute-management": "dev-master",
        "gz168/cache-management": "dev-master",
        "gz168/common": "dev-master",
        "gz168/custom-config": "dev-master",
        "gz168/customer": "dev-master",
        "gz168/database-backup": "dev-master",
        "gz168/deepseek": "dev-master",
        "gz168/demo-consumer": "dev-master",
        "gz168/export-management": "dev-master",
        "gz168/extension-data": "dev-master",
        "gz168/filament": "dev-master",
        "gz168/filament-admin": "dev-master",
        "gz168/front-nav": "dev-master",
        "gz168/git-management": "dev-master",
        "gz168/gmail-api": "dev-master",
        "gz168/kafka-management": "dev-master",
        "gz168/log-management": "dev-master",
        "gz168/mail": "dev-master",
        "gz168/module-core": "dev-master",
        "gz168/module-settings": "dev-master",
        "gz168/package-registration": "dev-master",
        "gz168/redis-management": "dev-master",
        "gz168/role-permission": "dev-master",
        "gz168/system-settings": "dev-master",
        "gz168/user-management": "dev-master",
        "laravel/framework": "^13.8",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.4",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan app:initialize --force",
            "npm install --ignore-scripts",
            "npm run setup:clients",
            "npm run build:all"
        ],
        "initialize": [
            "@php artisan app:initialize --force"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "test:front-nav": [
            "@php vendor/bin/pint --dirty",
            "@php vendor/bin/phpunit --no-coverage -c gz168/FrontNav/phpunit.xml",
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test --filter=FrontNav --compact",
            "@php -r \"chdir('packages/front-nav'); passthru('npm test 2>&1');\"",
            "@php -r \"chdir('packages/front-nav'); passthru('npm run typecheck 2>&1');\"",
            "@php -r \"chdir('apps/web'); passthru('npx tsc --noEmit 2>&1');\"",
            "@php -r \"chdir('apps/web'); passthru('npx eslint src/lib/front-nav.ts src/lib/server-customer.ts src/app/**/nav-demo/page.tsx 2>&1');\""
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade",
            "@php artisan filament:cache-components"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "gz168/ApiAuth"
        },
        {
            "type": "path",
            "url": "gz168/AttributeManagement"
        },
        {
            "type": "path",
            "url": "gz168/CacheManagement"
        },
        {
            "type": "path",
            "url": "gz168/Customer"
        },
        {
            "type": "path",
            "url": "gz168/CustomConfig"
        },
        {
            "type": "path",
            "url": "gz168/DemoConsumer"
        },
        {
            "type": "path",
            "url": "gz168/DatabaseBackup"
        },
        {
            "type": "path",
            "url": "gz168/ExportManagement"
        },
        {
            "type": "path",
            "url": "gz168/ExtensionData"
        },
        {
            "type": "path",
            "url": "gz168/FrontNav"
        },
        {
            "type": "path",
            "url": "gz168/Filament"
        },
        {
            "type": "path",
            "url": "gz168/GitManagement"
        },
        {
            "type": "path",
            "url": "gz168/GmailApi"
        },
        {
            "type": "path",
            "url": "gz168/KafkaManagement"
        },
        {
            "type": "path",
            "url": "gz168/LogManagement"
        },
        {
            "type": "path",
            "url": "gz168/Mail"
        },
        {
            "type": "path",
            "url": "gz168/ModuleSettings"
        },
        {
            "type": "path",
            "url": "gz168/PackageRegistration"
        },
        {
            "type": "path",
            "url": "gz168/RedisManagement"
        },
        {
            "type": "path",
            "url": "gz168/RolePermission"
        },
        {
            "type": "path",
            "url": "gz168/SystemSettings"
        },
        {
            "type": "path",
            "url": "gz168/UserManagement"
        },
        {
            "type": "path",
            "url": "gz168/common"
        },
        {
            "type": "path",
            "url": "gz168/deepseek"
        },
        {
            "type": "path",
            "url": "gz168/filament-admin"
        },
        {
            "type": "path",
            "url": "gz168/module-core"
        }
    ]
}
