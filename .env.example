APP_NAME=ERP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

SUPER_ADMIN_NAME="Super Administrator"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# gz168 modules (disabled by default)
# Run `php bin/install-gz168.php` to enable
GZ168_ENABLED=false
GZ168_MODULES_PATH=gz168

# Database backup (gz168/DatabaseBackup) toolchain overrides.
# Leave empty to fall back to `which <binary>` on $PATH.
# Set an absolute path when the binary is not on $PATH (e.g. macOS MySQL
# install at /usr/local/mysql-X.Y.Z-macosZZ-x86_64/bin/).
# DATABASE_BACKUP_MYSQLDUMP=/usr/local/mysql/bin/mysqldump
# DATABASE_BACKUP_MYSQL=/usr/local/mysql/bin/mysql
# DATABASE_BACKUP_GZIP=/usr/bin/gzip
# DATABASE_BACKUP_GUNZIP=/usr/bin/gunzip

# ----------------------------------------------------------------------------
# gz168/Customer — 前台用户域公共模块（参考 docs/architecture/gz168-customer.md）
# ----------------------------------------------------------------------------
# 后台管理开关：默认关闭；只有需要 Filament 后台时才置 true
GZ168_CUSTOMER_ADMIN_ENABLED=false

# 前台 API 路由前缀
GZ168_CUSTOMER_ROUTE_PREFIX=api/v1

# Sanctum session cookie 名（与 Laravel Sanctum 默认一致）
GZ168_CUSTOMER_COOKIE=gz168_customer_session

# Token TTL（分钟；native/wx 通道）
GZ168_CUSTOMER_TOKEN_TTL=43200

# 头像上传
GZ168_CUSTOMER_AVATAR_DISK=public
# GZ168_CUSTOMER_AVATAR_MAX_KB=2048

# 邮件
# GZ168_CUSTOMER_MAIL_FROM=
# GZ168_CUSTOMER_MAIL_NAME="Customer Service"

# 微信小程序登录（不填则 WxAuthService 不可用）
# GZ168_WX_APP_ID=
# GZ168_WX_APP_SECRET=
# GZ168_WX_MODE=mp

# 后台 actor 判定回调 — 默认通过 gz168/role-permission 的 hasRole('admin')。
# 若 host 项目使用 IAM/SSO，可注入自定义回调：
#   'customer.admin.admin_check_callback' => fn ($u) => YourIam::isAdmin($u),
# 配置位置：host 项目 config/customer.php

# --------------------------------------------------------------------------
# 邮箱管理模块（gz168/mail）—— 全部可选，不配置则 Gmail 相关能力不可用
# --------------------------------------------------------------------------

# Google OAuth 客户端（Gmail 收发共用；IMAP XOAUTH2 要求全量 scope，授权回调见下）
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_MAIL_REDIRECT_URI="${APP_URL}/api/mail/gmail/oauth/callback"

# QQ 发送 SMTP（授权码在后台账户里加密存储，无需 env）
# QQ_SMTP_HOST=smtp.qq.com
# QQ_SMTP_PORT=465
# QQ_SMTP_ENCRYPTION=ssl

# 收件同步（默认：自动同步关闭、每 5 分钟、INBOX、单批 50、超时 30s、历史保留 30 天）
# MAIL_SYNC_AUTO_ENABLED=false
# MAIL_SYNC_INTERVAL_MINUTES=5
# MAIL_SYNC_FOLDERS=INBOX
# MAIL_SYNC_BATCH_SIZE=50
# MAIL_SYNC_TIMEOUT=30
# MAIL_SYNC_RUNS_RETENTION_DAYS=30
# MAIL_SYNC_ALERT_CONSECUTIVE_FAILURES=3
# MAIL_SYNC_SETTINGS_PATH=存储路径，默认 storage/app/mail

# 发送限流（次/分钟/IP；0 关闭）
# MAIL_SEND_RATE_LIMIT=30

# 附件存储盘与目录
# MAIL_ATTACHMENTS_DISK=local
# MAIL_ATTACHMENTS_DIR=mail-attachments

# 双轨收敛开关（默认关闭：UI 与自动同步归 gz168/MailAdmin 拆分包）
# MAIL_FILAMENT_RESOURCES_ENABLED=false
# MAIL_V1_SCHEDULER_ENABLED=false
