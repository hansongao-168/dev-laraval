{
  "name": "@erp/front-schema",
  "version": "0.1.0",
  "private": true,
  "description": "Shared FrontExperience JSON Schema fixtures (page / skin / theme).",
  "type": "module",
  "exports": {
    "./page-document.json": "./schemas/page-document.json",
    "./skin-manifest.json": "./schemas/skin-manifest.json",
    "./theme.json": "./schemas/theme.json",
    "./validate": {
      "types": "./src/validate.d.ts",
      "default": "./src/validate.js"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "validate:fixtures": "node ./scripts/validate-fixtures.mjs"
  }
}
