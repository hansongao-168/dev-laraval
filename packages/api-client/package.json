{
  "name": "@erp/api-client",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./core": {
      "types": "./src/core/index.d.ts",
      "default": "./src/core/index.js"
    },
    "./core/http": {
      "types": "./src/core/http.d.ts",
      "default": "./src/core/http.js"
    },
    "./core/csrf": {
      "types": "./src/core/csrf.d.ts",
      "default": "./src/core/csrf.js"
    },
    "./core/cookie": {
      "types": "./src/core/cookie.d.ts",
      "default": "./src/core/cookie.js"
    },
    "./domain/customer": {
      "types": "./src/domain/customer/index.d.ts",
      "default": "./src/domain/customer/index.js"
    }
  }
}