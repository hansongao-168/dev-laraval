#!/usr/bin/env bash

set -euo pipefail

if [[ $# -lt 1 || $# -gt 2 ]]; then
    echo "Usage: bin/create-project <target-directory> [project-name]"
    exit 1
fi

source_directory="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
target_directory="$1"
project_name="${2:-$(basename "$target_directory")}"

target_has_git_repository=false

if [[ -e "$target_directory" ]]; then
    if [[ ! -d "$target_directory" ]]; then
        echo "Target exists and is not a directory: $target_directory"
        exit 1
    fi

    existing_entry="$(find "$target_directory" -mindepth 1 -maxdepth 1 ! -name '.git' -print -quit)"

    if [[ -n "$existing_entry" ]]; then
        echo "Target already contains project files: $target_directory"
        echo "Choose a new directory to prevent accidental overwrites."
        exit 1
    fi

    if [[ -d "$target_directory/.git" ]]; then
        if ! git -C "$target_directory" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
            echo "Target contains an invalid .git directory: $target_directory"
            exit 1
        fi

        if git -C "$target_directory" rev-parse --verify HEAD >/dev/null 2>&1; then
            echo "Target Git repository already contains commits: $target_directory"
            echo "Choose a new directory to prevent accidental history conflicts."
            exit 1
        fi

        target_has_git_repository=true
    fi
fi

if ! command -v rsync >/dev/null 2>&1; then
    echo "rsync is required to create a project copy."
    exit 1
fi

mkdir -p "$target_directory"

rsync -a \
    --exclude='.git/' \
    --exclude='.env' \
    --include='.env.example' \
    --include='.env.*.example' \
    --exclude='.env.*' \
    --exclude='vendor/' \
    --exclude='node_modules/' \
    --exclude='apps/*/node_modules/' \
    --exclude='apps/*/.expo/' \
    --exclude='apps/*/.next/' \
    --exclude='apps/*/dist/' \
    --exclude='public/build/' \
    --exclude='public/hot' \
    --exclude='storage/logs/*' \
    --exclude='storage/framework/cache/data/*' \
    --exclude='storage/framework/sessions/*' \
    --exclude='storage/framework/views/*' \
    --exclude='knowledge/.obsidian/cache/' \
    --exclude='knowledge/.obsidian/workspace.json' \
    --exclude='knowledge/.obsidian/workspace-mobile.json' \
    "$source_directory/" "$target_directory/"

cp "$target_directory/.env.example" "$target_directory/.env"

php -r '
    $path = $argv[1];
    $name = $argv[2];
    $contents = file_get_contents($path);
    $escaped = str_replace(["\\", "\""], ["\\\\", "\\\""], $name);
    $contents = preg_replace("/^APP_NAME=.*$/m", "APP_NAME=\"{$escaped}\"", $contents, 1);
    file_put_contents($path, $contents);
' "$target_directory/.env" "$project_name"

if [[ "$target_has_git_repository" == false ]]; then
    git -C "$target_directory" init -b main >/dev/null
fi

echo
echo "Project created: $target_directory"
echo "Project name: $project_name"
if [[ "$target_has_git_repository" == true ]]; then
    echo "Existing empty Git repository and its remotes were preserved."
fi
echo
echo "Next steps:"
echo "  1. Edit $target_directory/.env"
echo "  2. Configure MySQL, Redis, APP_URL and protected administrator values"
echo "  3. cd $target_directory"
echo "  4. composer setup"
echo "  5. Open $target_directory/knowledge as an Obsidian vault"
echo
echo "No source .env, dependency directory, build output, or Git history was copied."

if [[ -t 0 ]]; then
    echo
    read -r -p "Configure the new .env now? [Y/n]: " configure_environment

    if [[ ! "$configure_environment" =~ ^[Nn]$ ]]; then
        "$target_directory/bin/configure-env" "$target_directory"
    fi
fi
