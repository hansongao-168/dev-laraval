{
  "_comment": "CI-only tsconfig: scope typecheck to the FrontNav consumer files.",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@erp/api-client": ["../../packages/api-client/src/index.d.ts"],
      "@erp/api-client/*": ["../../packages/api-client/src/*"],
      "@erp/front-nav": ["../../packages/front-nav/src/index.d.ts"],
      "@erp/front-nav/*": ["../../packages/front-nav/src/*"]
    },
    "baseUrl": "."
  },
  "include": [
    "src/lib/front-nav.ts",
    "src/app/(desktop)/nav-demo/page.tsx",
    "../../packages/api-client/src/**/*.d.ts",
    "../../packages/front-nav/src/**/*.d.ts"
  ]
}
