{
  "compilerOptions": {
    "target": "es2017",
    "module": "commonjs",
    "removeComments": false,
    "preserveConstEnums": true,
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "noImplicitAny": false,
    "allowSyntheticDefaultImports": true,
    "outDir": "lib",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "rootDir": ".",
    "jsx": "react-jsx",
    "allowJs": true,
    "resolveJsonModule": true,
    "typeRoots": [
      "node_modules/@types"
    ],
    "paths": {
      // TS5090 leading './'
      "@/*": ["./src/*"],
      // moduleResolution:node 不支持 package exports 子路径映射,
      // 显式把 @erp/front-nav 的子路径指到源码 .d.ts
      "@erp/front-nav": ["../../packages/front-nav/src/index.d.ts"],
      "@erp/front-nav/core": ["../../packages/front-nav/src/core/index.d.ts"],
      "@erp/front-nav/react": ["../../packages/front-nav/src/react/index.d.ts"]
    }
  },
  "include": ["./src", "./types", "./config"],
  "compileOnSave": false
}
